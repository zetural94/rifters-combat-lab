{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Card shapes the combat lab engine reads. Nested fields (xStat, breakStat, maxTargets, gate.n, status.x) are checked deeply.",
  "$defs": {
    "stat": { "enum": ["STR", "DEX", "INT"] },
    "pool": { "type": "string", "pattern": "^-?\\d+\\s*/\\s*-?\\d+$" },
    "stringList": { "type": "array", "items": { "type": "string" } },
    "numberMap": { "type": "object", "additionalProperties": { "type": "number" } },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stat"],
      "properties": {
        "stat": { "type": "string" },
        "n": { "type": "number" },
        "nBonus": { "type": "number" },
        "vs": { "type": "string" },
        "vsStat": { "type": "string" }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "x": { "type": "number" },
        "xStat": { "$ref": "#/$defs/stat" },
        "xStatMult": { "type": "number" },
        "text": { "type": "string" },
        "gate": { "$ref": "#/$defs/gate" }
      }
    },
    "statusOrList": {
      "oneOf": [
        { "$ref": "#/$defs/status" },
        { "type": "array", "items": { "$ref": "#/$defs/status" }, "minItems": 1 }
      ]
    },
    "cleanse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "x": { "type": "number" },
        "range": { "type": "number" }
      }
    },
    "extra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "x": { "type": "number" },
        "xStat": { "$ref": "#/$defs/stat" },
        "xStatMult": { "type": "number" },
        "range": { "type": "number" },
        "dmgType": { "type": "string" },
        "orCleanse": { "type": "number" },
        "gate": { "$ref": "#/$defs/gate" },
        "cleanse": { "$ref": "#/$defs/cleanse" },
        "slow": { "$ref": "#/$defs/status" }
      }
    },
    "maxTargets": {
      "oneOf": [
        { "type": "number", "minimum": 1 },
        { "type": "string", "pattern": "^\\d+\\s*\\+\\s*(STR|DEX|INT)$" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["base", "stat"],
          "properties": {
            "base": { "type": "number" },
            "stat": { "$ref": "#/$defs/stat" }
          }
        }
      ]
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dmg": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
        "dmgType": { "type": "string" },
        "dmgStat": { "$ref": "#/$defs/stat" },
        "dmgStatMult": { "type": "number" },
        "dmgFallback": { "type": "number" },
        "dmgBonus": { "type": "number" },
        "dmgFlat": { "type": "number" },
        "dmgPerUnit": { "type": "number" },
        "aoeMode": { "type": "string" },
        "aoeRange": { "type": "number" },
        "break": { "type": "number" },
        "breakStat": { "$ref": "#/$defs/stat" },
        "status": { "$ref": "#/$defs/statusOrList" },
        "extras": { "type": "array", "items": { "$ref": "#/$defs/extra" } },
        "text": { "type": "string" }
      }
    },
    "roll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stat", "mode"],
      "properties": {
        "stat": { "type": "string" },
        "mode": { "enum": ["power", "flat"] }
      }
    },
    "leaveTerrain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "difficult": { "type": "boolean" },
        "enterDmg": { "type": "number" },
        "unpreventable": { "type": "boolean" }
      }
    },
    "aoe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "range": { "type": "number" },
        "shape": { "type": "string" },
        "size": { "type": "number" },
        "maxTargets": { "$ref": "#/$defs/maxTargets" },
        "leaveTerrain": { "$ref": "#/$defs/leaveTerrain" }
      }
    },
    "trait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "x": { "type": "number" },
        "onCritBonusDmg": { "type": "number" },
        "freeOaPerRound": { "type": "number" },
        "oaRange": { "type": "number" },
        "stressCost": { "type": "number" },
        "require": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "selfBloodied": { "type": "boolean" } }
        }
      }
    },
    "passive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "rule": { "type": "string" },
        "when": { "type": "string" }
      }
    },
    "crit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "range": { "type": "number" },
        "status": { "$ref": "#/$defs/statusOrList" }
      }
    },
    "kitRef": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }] }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "name"],
      "properties": {
        "kind": { "const": "hero" },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "notes": { "type": "string" },
        "hpMax": { "type": "number" },
        "hp": { "$ref": "#/$defs/pool" },
        "speed": { "type": "number" },
        "size": { "type": "number" },
        "str": { "type": "number" },
        "dex": { "type": "number" },
        "int": { "type": "number" },
        "stability": { "type": "number" },
        "stressMax": { "type": "number" },
        "stress": { "$ref": "#/$defs/pool" },
        "apMax": { "type": "number" },
        "mana": { "$ref": "#/$defs/pool" },
        "recoveries": { "$ref": "#/$defs/pool" },
        "armorId": { "type": "string" },
        "activeKit": { "type": "number" },
        "weaponOptions": { "type": "array", "items": { "$ref": "#/$defs/kitRef" } },
        "def": { "$ref": "#/$defs/numberMap" },
        "abilities": { "$ref": "#/$defs/stringList" },
        "passive": { "type": "string" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "name"],
      "properties": {
        "kind": { "const": "monster" },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "notes": { "type": "string" },
        "role": { "type": "string" },
        "monsterType": { "type": "string" },
        "bossMode": { "type": "string" },
        "bossTurns": { "type": "number" },
        "tags": { "$ref": "#/$defs/stringList" },
        "token": { "type": "string" },
        "aiPattern": { "$ref": "#/$defs/stringList" },
        "hpMax": { "type": "number" },
        "unitHp": { "type": "number" },
        "units": { "type": "number" },
        "speed": { "type": "number" },
        "size": { "type": "number" },
        "str": { "type": "number" },
        "dex": { "type": "number" },
        "int": { "type": "number" },
        "stability": { "type": "number" },
        "economy": { "type": "string" },
        "battlePoints": { "type": "number" },
        "immuneStatuses": { "$ref": "#/$defs/stringList" },
        "def": { "$ref": "#/$defs/numberMap" },
        "vulnerable": { "$ref": "#/$defs/numberMap" },
        "bloodied": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "speedMod": { "type": "number" },
            "stabilityMod": { "type": "number" },
            "defMod": { "$ref": "#/$defs/numberMap" }
          }
        },
        "passive": { "$ref": "#/$defs/passive" },
        "crit": { "$ref": "#/$defs/crit" },
        "abilities": { "$ref": "#/$defs/stringList" },
        "reactions": { "$ref": "#/$defs/stringList" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "name"],
      "properties": {
        "kind": { "const": "ability" },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "notes": { "type": "string" },
        "costAp": { "type": "number" },
        "costStress": { "type": "number" },
        "costMana": { "type": "number" },
        "range": { "type": "number" },
        "adv": { "type": "number" },
        "optionalStressAdv": { "type": "number" },
        "isAttack": { "type": "boolean" },
        "selfAoe": { "type": "boolean" },
        "useWeapon": { "type": "boolean" },
        "dmgType": { "type": "string" },
        "weaponId": { "type": "string" },
        "kitId": { "type": "string" },
        "kitModes": { "$ref": "#/$defs/stringList" },
        "roll": { "$ref": "#/$defs/roll" },
        "aoe": { "$ref": "#/$defs/aoe" },
        "tiers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "t1": { "$ref": "#/$defs/tier" },
            "t2": { "$ref": "#/$defs/tier" },
            "t3": { "$ref": "#/$defs/tier" },
            "flat": { "$ref": "#/$defs/tier" }
          }
        },
        "traits": { "type": "array", "items": { "$ref": "#/$defs/trait" } },
        "crit": { "$ref": "#/$defs/crit" }
      }
    }
  ]
}
